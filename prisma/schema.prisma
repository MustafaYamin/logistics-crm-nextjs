generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-1.0.x", "linux-musl"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   Int           @id @default(autoincrement())
  name                 String
  slug                 String        @unique
  plan                 Plan          @default(FREE)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  seats                Int           @default(1)
  
  // Custom SMTP Settings
  smtpHost             String?
  smtpPort             Int?
  smtpUser             String?
  smtpPass             String?       @db.Text

  createdAt            DateTime      @default(now())
  
  members              OrgMember[]
  agents               Agent[]
  emailTemplates       EmailTemplate[]
  freightQueries       FreightQuery[]
  emailStatuses        EmailStatus[]
}

model OrgMember {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  role           OrgRole      @default(MEMBER)
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  memberships  OrgMember[]
}

model Agent {
  id             Int          @id @default(autoincrement())
  organizationId Int
  name           String
  email          String
  phone          String?
  company        String?
  address        String?
  city           String?
  country        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relation
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Composite unique constraint
  @@unique([organizationId, email])
}

model EmailTemplate {
  id             Int          @id @default(autoincrement())
  organizationId Int
  name           String
  subject        String
  htmlContent    String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model FreightQuery {
  id                  Int          @id @default(autoincrement())
  organizationId      Int
  origin              String
  destination         String
  cargoType           String
  weight              String
  dimensions          String
  pickupDate          String 
  deliveryDate        String
  specialRequirements String?      @db.Text
  createdAt           DateTime     @default(now())

  organization        Organization @relation(fields: [organizationId], references: [id])
}

model EmailStatus {
  id             Int          @id @default(autoincrement())
  organizationId Int
  agentName      String
  email          String
  status         String       // pending, sent, delivered, etc.
  sentAt         DateTime?
  openedAt       DateTime?
  repliedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
}